# Port the Builder app (and its REST API) listens on.
BUILDER_PORT=5111

# Prisma + SQLite. The path is resolved relative to prisma/schema.prisma, so this is
# apps/builder/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Secret used to sign (HMAC-SHA256) the owner session cookie. Required — the Builder app
# throws at startup if it's unset. Use a long random string for anything beyond local dev.
SESSION_SECRET="dev-only-insecure-change-me"

# Anthropic Claude API key (used by the ai-copy-and-variants feature).
ANTHROPIC_API_KEY=
